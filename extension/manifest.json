{
  "manifest_version": 3,
  "name": "Video Extractor",
  "version": "1.0.0",
  "description": "Detecta e extrai todos os vídeos de uma página: arquivos diretos, HLS (m3u8), DASH (mpd), blobs/MSE e mídia vinda de requisições GET/POST.",
  "minimum_chrome_version": "116",
  "homepage_url": "https://github.com/XuanDeveloper/video-extractor",
  "permissions": [
    "webRequest",
    "storage",
    "downloads",
    "tabs",
    "scripting",
    "offscreen",
    "contextMenus",
    "unlimitedStorage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Video Extractor",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "js": ["src/content/mse-mux.js", "src/content/page-hook.js"],
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "js": ["src/content/content.js"],
      "world": "ISOLATED"
    }
  ]
}
